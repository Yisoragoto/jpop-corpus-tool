{
  "comment": "Karaoke subtitle style shared by Windows (app/src/karaokeStyle.ts) and macOS (JPCore/KaraokeStyle.swift). Both test suites read this file, so the field names, presets and normalisation rules stay identical on the two clients.",
  "defaultPreset": "plain",
  "presets": {
    "classic": {
      "fontFamily": "",
      "fontSize": 56,
      "fontWeight": 900,
      "unsungFill": "#f4f4f4",
      "unsungStroke": "#000000",
      "unsungGlow": "#2a78ff",
      "sungFill": "#3a8cf5",
      "sungStroke": "#ffffff",
      "sungGlow": "#2a78ff",
      "strokeWidth": 3,
      "glowStrength": 8,
      "shadowColor": "#000000",
      "shadowDepth": 2,
      "staggered": true
    },
    "pink": {
      "fontFamily": "",
      "fontSize": 56,
      "fontWeight": 800,
      "unsungFill": "#ffffff",
      "unsungStroke": "#d96bf0",
      "unsungGlow": "#e070ff",
      "sungFill": "#ec4f95",
      "sungStroke": "#ffffff",
      "sungGlow": "#ff5fb0",
      "strokeWidth": 4,
      "glowStrength": 16,
      "shadowColor": "#6a2a86",
      "shadowDepth": 3,
      "staggered": true
    },
    "plain": {
      "fontFamily": "",
      "fontSize": 56,
      "fontWeight": 700,
      "unsungFill": "#ffffff",
      "unsungStroke": "#000000",
      "unsungGlow": "#000000",
      "sungFill": "#4cc2ff",
      "sungStroke": "#000000",
      "sungGlow": "#000000",
      "strokeWidth": 0,
      "glowStrength": 6,
      "shadowColor": "#000000",
      "shadowDepth": 0,
      "staggered": true
    }
  },
  "normalize": [
    {
      "input": {},
      "output": "plain"
    },
    {
      "input": {
        "fontFamily": "  Meiryo  ",
        "fontSize": 200,
        "fontWeight": 640,
        "unsungFill": "#ABCDEF",
        "unsungStroke": "red",
        "sungFill": "#12345",
        "strokeWidth": -3,
        "glowStrength": 12.6,
        "staggered": false,
        "shadowColor": "#FFF",
        "shadowDepth": 4.4
      },
      "output": {
        "fontFamily": "Meiryo",
        "fontSize": 96,
        "fontWeight": 600,
        "unsungFill": "#abcdef",
        "unsungStroke": "#000000",
        "unsungGlow": "#000000",
        "sungFill": "#4cc2ff",
        "sungStroke": "#000000",
        "sungGlow": "#000000",
        "strokeWidth": 0,
        "glowStrength": 13,
        "shadowColor": "#000000",
        "shadowDepth": 4,
        "staggered": false
      }
    },
    {
      "input": {
        "fontSize": 10,
        "fontWeight": 100,
        "strokeWidth": 30,
        "glowStrength": 99,
        "staggered": "yes",
        "shadowDepth": 50
      },
      "output": {
        "fontFamily": "",
        "fontSize": 28,
        "fontWeight": 400,
        "unsungFill": "#ffffff",
        "unsungStroke": "#000000",
        "unsungGlow": "#000000",
        "sungFill": "#4cc2ff",
        "sungStroke": "#000000",
        "sungGlow": "#000000",
        "strokeWidth": 12,
        "glowStrength": 40,
        "shadowColor": "#000000",
        "shadowDepth": 12,
        "staggered": true
      }
    }
  ]
}
